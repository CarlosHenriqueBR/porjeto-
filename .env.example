# ============================================================================
# Copie para .env.local (dev) e configure as mesmas na Vercel
# (Settings → Environment Variables)
# ============================================================================

# --- OBRIGATÓRIAS EM PRODUÇÃO ------------------------------------------------
# Gere cada uma com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=troque-por-uma-string-aleatoria-longa
VAULT_SECRET=outra-string-aleatoria-diferente-da-de-cima

# Senha inicial dos 3 sócios. Só é usada na primeira execução, quando o banco
# é criado. Cada pessoa é obrigada a trocar no primeiro acesso.
SEED_PASSWORD=Operacao@2026

# --- BANCO -------------------------------------------------------------------
# Sem nada configurado: grava em ./data/db.json (só serve para rodar local).
# Em produção defina UMA das opções abaixo. A ordem de prioridade é a mesma.

# Opção A (recomendada) — Supabase, via API REST. Zero dependências de npm.
# Rode supabase-setup.sql no SQL Editor do projeto ANTES do primeiro acesso.
# Settings > API: "Project URL" e a chave "service_role" (NUNCA a anon).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Opção B — Neon / Postgres (exige: npm i @neondatabase/serverless)
# DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Opção C — Upstash Redis ou Vercel KV
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Opção D — Vercel Blob
# BLOB_READ_WRITE_TOKEN=

# --- UTMIFY ------------------------------------------------------------------
# Caminho 1 (recomendado): servidor MCP da UTMify — cole a URL completa com o token
UTMIFY_MCP_URL=
# Depois de rodar "Descobrir ferramentas MCP" em Configurações, fixe a escolhida:
# UTMIFY_MCP_TOOL=
# UTMIFY_MCP_ARGS={"startDate":"{date}","endDate":"{date}"}
# Mapeamento manual dos campos (opcional — por padrão o sistema detecta sozinho):
# UTMIFY_FIELD_REVENUE=data.summary.revenue
# UTMIFY_FIELD_ADSPEND=data.summary.adSpend
# UTMIFY_FIELD_PROFIT=data.summary.profit

# Caminho 2: qualquer endpoint REST que devolva JSON
# UTMIFY_METRICS_URL=https://.../metrics?date={date}
# UTMIFY_TOKEN=

# Caminho 3: push externo (n8n, Make, script) via header x-ingest-token
INGEST_TOKEN=

# Protege o cron diário da Vercel
CRON_SECRET=
